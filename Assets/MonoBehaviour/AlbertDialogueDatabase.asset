  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8f5d7090cc7cd2090b6a9fe1738392c3, type: 3}
  m_Name: AlbertDialogueDatabase
  m_EditorClassIdentifier:
  Modules: []
  GenericEntries:
  - Key: supplier_unlocked
    Chains:
    - Lines:
      - Hello, our mutual friend has asked me to help you acquire some Marijuana seeds.
      - Send me a message if you'd like to order some. Nelson has put in a good word for you, so I'll provide you a tab which you can pay off later.
  - Key: supplier_meet_confirm
    Chains:
    - Lines:
      - Agreed. I'll be <LOCATION> for the next 6 hours.
  - Key: supplier_meeting_greeting
    Chains:
    - Lines:
      - Hello sir. Ready to peruse the supplies?
  - Key: meeting_order_complete
    Chains:
    - Lines:
      - Good doing business with you, sir.
  - Key: supplier_meetings_unlocked
    Chains:
    - Lines:
      - 'We''ve been working together for a while now, and you''ve proven to be quite reliable. '
      - If you're needing to order larger quantities of supplies, you can now organize an in-person meeting with me. Just send me a text.
