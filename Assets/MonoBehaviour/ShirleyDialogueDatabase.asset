  m_Script: {fileID: 11500000, guid: 8f5d7090cc7cd2090b6a9fe1738392c3, type: 3}
  m_Name: ShirleyDialogueDatabase
  m_EditorClassIdentifier:
  Modules: []
  GenericEntries:
  - Key: supplier_unlocked
    Chains:
    - Lines:
      - Heyo, I'm Shirley. I work in the pharmaceutical business, and heard you got a nasty cough...
      - If you're in need of some pseudo, I'm your gal. Send me a message and we'll figure something out
  - Key: supplier_meet_confirm
    Chains:
    - Lines:
      - Okay. I'll be <LOCATION> for the next 6 hours.
  - Key: supplier_meeting_greeting
    Chains:
    - Lines:
      - Hey - ready to take a peek at the supplies?
  - Key: meeting_order_complete
    Chains:
    - Lines:
      - Thank you
  - Key: supplier_meetings_unlocked
    Chains:
    - Lines:
      - Hey, you've been great to work with so I'm willing to start doing in-person meetings with you. At a meeting, you buy as much pseudo as you can carry - no more order limits.
      - Just send me a text if you'd like to meet.
