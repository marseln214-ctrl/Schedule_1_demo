  DialogueNodeData:
  - Guid: 4762cc99-7fa6-4eab-8358-81ea5c6da963
    DialogueText: Sorry, you don't have enough money for that model.
    DialogueNodeLabel:
    Position: {x: 1399, y: 381}
    choices: []
    VoiceLine: 0
  - Guid: cc0d838e-2824-4fd5-907d-798dc0195c16
    DialogueText: Welcome to Hyland Auto. What can I do for you?
    DialogueNodeLabel: ENTRY
    Position: {x: 139, y: 421}
    choices:
    - Guid: 5527e239-d9b2-46bc-9170-2340cca12a52
      ChoiceText: I'd like to purchase a vehicle
      ChoiceLabel:
    - Guid: 7437fcf0-adcb-4e66-aeb6-f65fab7e3bc7
      ChoiceText: Bye
      ChoiceLabel:
    VoiceLine: 0
  - Guid: edb3c6ed-6884-4b32-809d-be12a5ffac65
    DialogueText: Oh okay, I'll be here if you change your mind.
    DialogueNodeLabel:
    Position: {x: 1833, y: 827}
    choices: []
    VoiceLine: 0
  - Guid: 80b9c95c-384b-4314-be00-18f5b035ed10
    DialogueText: Good doing business with ya! Your new ride is waiting outisde.
    DialogueNodeLabel:
    Position: {x: 1833, y: 589}
    choices: []
    VoiceLine: 0
  - Guid: b6f6a4ce-849c-4047-b705-7a20440de0e0
    DialogueText: So you'd like to purchase the <VEHICLE>?
