    choices:
    - Guid: 01ced615-b8c7-4f6a-ab73-7345a5edd75e
      ChoiceText: Yes (<PRICE>)
      ChoiceLabel: BUY_ONLINE
    - Guid: 2059ec61-c218-4b00-9475-59aa519379ff
      ChoiceText: Actually, nevermind.
      ChoiceLabel:
    VoiceLine: 0
  - Guid: 8e2ef594-96d9-43f2-8cfa-6efaea823a56
    DialogueText: Fantastic! Which model are you interested in?
    DialogueNodeLabel:
    Position: {x: 572, y: 427}
