  DialogueNodeData:
  - Guid: cd5c04f0-e549-43d5-9cde-92090fc40c89
    DialogueText: Good. I’m Manny. I’m the local fixer. You looking to hire workers, you talk to me.
    DialogueNodeLabel:
    Position: {x: 994, y: 272}
    choices:
    - Guid: 680c76bf-7ac5-4512-92d8-fd4145eb31f8
      ChoiceText: How much does it cost to hire someone?
      ChoiceLabel:
    - Guid: 70834651-e06c-4a33-96c9-61fe9eee4ed5
      ChoiceText: Thanks
      ChoiceLabel:
    VoiceLine: 0
  - Guid: ed34d238-6296-4087-9b43-23a5df43b2d4
    DialogueText: Haha very cute. I’m Manny. I’m the local fixer. You looking to hire workers, you talk to me.
    DialogueNodeLabel:
    Position: {x: 994, y: 514}
    choices:
    - Guid: b688a721-c7f6-4498-b83f-465f75a28a7e
      ChoiceText: How much does it cost to hire someone?
      ChoiceLabel:
    - Guid: bd3f2c9b-0dbb-4d38-a5d0-1221fc288ccd
      ChoiceText: Thanks
      ChoiceLabel:
    VoiceLine: 0
  - Guid: f2543a79-ca0b-4ca5-9069-99f07eb17d4e
    DialogueText: Alright then, fuck off.
    DialogueNodeLabel:
    Position: {x: 994, y: 748}
    choices: []
    VoiceLine: 9
  - Guid: 0e6393c6-2fcf-403a-883f-8acc76befd79
    DialogueText: Depends on what sort of talent you need. Cleaners and Packagers are pretty cheap, Botanists a bit more, and Chemists are the most expensive.
    DialogueNodeLabel:
    Position: {x: 1707, y: 323}
    choices:
    - Guid: fb350f4d-17f8-4efb-93fc-fc58817ef6ba
      ChoiceText: Thanks
      ChoiceLabel:
    VoiceLine: 0
  - Guid: 5dbc712f-d4cd-4487-b0f6-57f3d00a0255
    DialogueText: "You the new guy in town?\t"
