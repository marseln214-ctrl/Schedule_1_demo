  - Guid: e8d3d1a7-621c-44d2-a0c6-927980b0561d
    DialogueText: Hey there buddy, what can I do for you?
    DialogueNodeLabel: ENTRY
    Position: {x: 467, y: 297}
    choices:
    - Guid: 86ea0b51-597e-4ffe-8c63-5651d82ca801
      ChoiceText: I'd like to repaint my vehicle
