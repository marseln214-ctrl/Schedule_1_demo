  DialogueNodeData:
  - Guid: cddb54e4-8272-47c2-b988-efbbc950982e
    DialogueText: Evenin', you'd you get on in town?
    DialogueNodeLabel: ENTRY
    Position: {x: 177, y: 291}
    choices:
    - Guid: 0b5136ef-f277-4395-9387-db71829f563c
      ChoiceText: All good. Got your package but those guys were pretty antsy
      ChoiceLabel:
    VoiceLine: 1
  - Guid: ad1e3a94-e04e-4cc6-81eb-ba258af80603
    DialogueText: Oh yeah? Eh don't worry about 'em. I'll settle with them soon enough. Thanks for grabbing that for me.
    DialogueNodeLabel:
    Position: {x: 715, y: 425}
    choices:
    - Guid: 5485c79c-2475-43d9-a0a3-66cfa43bde99
      ChoiceText:
      ChoiceLabel:
    VoiceLine: 0
  - Guid: 4acad854-40d9-4bcf-9c72-cae663a9fce9
    DialogueText: Well I'll let you get on with it. See ya tomorrow, bud.
    DialogueNodeLabel: END
