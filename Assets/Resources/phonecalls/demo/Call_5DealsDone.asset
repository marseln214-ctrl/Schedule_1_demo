%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 710e1bac7a011e4d458ef6c347ab4156, type: 3}
  m_Name: Call_5DealsDone
  m_EditorClassIdentifier:
  CallerID: {fileID: 11400000, guid: 09cdebfe05ccaad41adda79be1ca9067, type: 2}
  Stages:
  - Text: You've finished a few deals and made some decent cash, but if you're looking to make real money, you'll need to expand your operations - more <h1>product</h> and more <h1>customers</h>.
    OnStartTriggers: []
    OnDoneTriggers: []
  - Text: The best way to gain new customers is to give a <h1>free sample</h> to a friend of an existing customer.
    OnStartTriggers: []
    OnDoneTriggers: []
  - Text: You can view all potential customers on your <h1>map</h>. Grab some weed and give them a <h1>free sample</h>. With a bit of luck, they'll agree to become a customer.
    OnStartTriggers: []
    OnDoneTriggers: []
  - Text: To keep up with more customers, you'll need more product. The motel room isn't gonna cut it for much longer - time for an upgrade.
    OnStartTriggers: []
    OnDoneTriggers: []
  - Text: There's a cheap room for sale above the Chinese restaurant just north of your motel room. Save <h1>$500</h>, then go ask about buying the room.
    OnStartTriggers: []
    OnDoneTriggers:
    - Conditions:
        EvaluationType: 0
        ConditionList: []
        QuestConditionList: []
      onEvaluateTrueVariableSetters: []
      onEvaluateTrueQuestSetters:
      - QuestName: On the Grind
        SetQuestState: 0
        QuestState: 0
        SetQuestEntryState: 1
        QuestEntryIndex: 5
        QuestEntryState: 2
      onEvaluateTrue:
        m_PersistentCalls:
          m_Calls: []
      onEvaluateFalseVariableSetters: []
      onEvaluateFalseQuestSetters: []
      onEvaluateFalse:
        m_PersistentCalls:
          m_Calls: []
  onCallCompleted:
    m_PersistentCalls:
      m_Calls: []
