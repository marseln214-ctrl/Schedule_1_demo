%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 710e1bac7a011e4d458ef6c347ab4156, type: 3}
  m_Name: Call_SupplierIntro
  m_EditorClassIdentifier:
  CallerID: {fileID: 11400000, guid: 09cdebfe05ccaad41adda79be1ca9067, type: 2}
  Stages:
  - Text: You're almost ready to go, but you're missing one key ingredient - <h1>weed seeds</h>.
    OnStartTriggers: []
    OnDoneTriggers: []
  - Text: You'll need to speak to a supplier to get your hands on some seeds. I've passed your number onto <h1>Albert Hoover</h> - the local weed seed supplier.
    OnStartTriggers: []
    OnDoneTriggers: []
  - Text: Send him a <h1>message</h> and request a <h1>dead drop</h>. I've vouched for you so you won't have to pay up front. Your order will go on your tab, which you can pay off in the future.
    OnStartTriggers: []
    OnDoneTriggers:
    - Conditions:
        EvaluationType: 0
        ConditionList: []
        QuestConditionList: []
      onEvaluateTrueVariableSetters: []
      onEvaluateTrueQuestSetters:
      - QuestName: Gearing Up
        SetQuestState: 0
        QuestState: 0
        SetQuestEntryState: 1
        QuestEntryIndex: 6
        QuestEntryState: 2
      onEvaluateTrue:
        m_PersistentCalls:
          m_Calls: []
      onEvaluateFalseVariableSetters: []
      onEvaluateFalseQuestSetters: []
      onEvaluateFalse:
        m_PersistentCalls:
          m_Calls: []
  onCallCompleted:
    m_PersistentCalls:
      m_Calls: []
