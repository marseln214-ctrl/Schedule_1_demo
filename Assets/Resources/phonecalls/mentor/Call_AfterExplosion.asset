  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 710e1bac7a011e4d458ef6c347ab4156, type: 3}
  m_Name: Call_AfterExplosion
  m_EditorClassIdentifier:
  CallerID: {fileID: 11400000, guid: 09cdebfe05ccaad41adda79be1ca9067, type: 2}
  Stages:
  - Text: Well shit... that's not ideal.
    OnStartTriggers: []
    OnDoneTriggers: []
  - Text: There's a powerful Cartel in town, the <h1>Benzies family.</h> I figured they'd eventually be a problem, but didn't think they'd find you this quickly...
    OnStartTriggers: []
    OnDoneTriggers: []
  - Text: Looks like you're gonna need somewhere low key to stay for a while. Head over to the <h1>motel</h> and ask about getting a room.
    OnStartTriggers: []
    OnDoneTriggers:
    - Conditions:
        EvaluationType: 0
        ConditionList: []
        QuestConditionList: []
      onEvaluateTrueVariableSetters: []
      onEvaluateTrueQuestSetters:
      - QuestName: Welcome to Hyland Point
        SetQuestState: 0
        QuestState: 0
        SetQuestEntryState: 1
        QuestEntryIndex: 8
        QuestEntryState: 2
      onEvaluateTrue:
        m_PersistentCalls:
          m_Calls: []
      onEvaluateFalseVariableSetters: []
      onEvaluateFalseQuestSetters: []
      onEvaluateFalse:
        m_PersistentCalls:
          m_Calls: []
  onCallCompleted:
    m_PersistentCalls:
      m_Calls: []
