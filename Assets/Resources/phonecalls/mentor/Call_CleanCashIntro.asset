%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 710e1bac7a011e4d458ef6c347ab4156, type: 3}
  m_Name: Call_CleanCashIntro
  m_EditorClassIdentifier:
  CallerID: {fileID: 11400000, guid: 09cdebfe05ccaad41adda79be1ca9067, type: 2}
  Stages:
  - Text: Looks like you've reached your <h1>daily deposit limit...</h> To avoid arousing suspicion, you can only deposit so much cash each day via ATMs.
    OnStartTriggers: []
    OnDoneTriggers: []
  - Text: If you want to convert more cash to online balance, you're gonna need to start <h1>laundering</h>.
    OnStartTriggers: []
    OnDoneTriggers: []
  - Text: Laundering involves using a legal business to conceal the origin of your less-than-legal cash.
    OnStartTriggers: []
    OnDoneTriggers: []
  - Text: First thing's first, you're gonna need a business. Go check out <h1>Rays Realty</h>. You're probably not gonna be buying out the casino any time soon, but there should be a cheap business for sale.
    OnStartTriggers: []
    OnDoneTriggers:
    - Conditions:
        EvaluationType: 0
        ConditionList: []
        QuestConditionList: []
      onEvaluateTrueVariableSetters: []
      onEvaluateTrueQuestSetters:
      - QuestName: Clean Cash
        SetQuestState: 0
        QuestState: 0
        SetQuestEntryState: 1
        QuestEntryIndex: 0
        QuestEntryState: 2
      onEvaluateTrue:
        m_PersistentCalls:
          m_Calls: []
      onEvaluateFalseVariableSetters: []
      onEvaluateFalseQuestSetters: []
      onEvaluateFalse:
        m_PersistentCalls:
          m_Calls: []
  onCallCompleted:
    m_PersistentCalls:
      m_Calls: []
