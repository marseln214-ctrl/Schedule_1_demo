%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 710e1bac7a011e4d458ef6c347ab4156, type: 3}
  m_Name: Call_NelsonIntro
  m_EditorClassIdentifier:
  CallerID: {fileID: 11400000, guid: 09cdebfe05ccaad41adda79be1ca9067, type: 2}
  Stages:
  - Text: Goddamn, good to hear your voice, buddy! Looks like our luck finally ran out - the feds have got me in locked up while I wait for trial. Glad to hear you managed to slip out,  though.
    OnStartTriggers: []
    OnDoneTriggers: []
  - Text: Back before I moved to Serena Flats, I used to live out there in Hyland Point. Not the nicest town around, but plenty of opportunity for a dru-... someone in your line of work.
    OnStartTriggers: []
    OnDoneTriggers: []
  - Text: If memory serves, I've got some cash stashed out there. It ain't much, but it'll be enough to get you back on your feet.
    OnStartTriggers: []
    OnDoneTriggers: []
  - Text: You can find it stashed near the <h1>town hall fountain, in the canal,</h> and <h1>behind the supermarket</h>. Go grab it, head back to the RV, and we'll go from there.
    OnStartTriggers: []
    OnDoneTriggers:
    - Conditions:
        EvaluationType: 0
        ConditionList: []
        QuestConditionList: []
      onEvaluateTrueVariableSetters: []
      onEvaluateTrueQuestSetters:
      - QuestName: Welcome to Hyland Point
        SetQuestState: 0
        QuestState: 0
        SetQuestEntryState: 1
        QuestEntryIndex: 1
        QuestEntryState: 2
      onEvaluateTrue:
        m_PersistentCalls:
          m_Calls: []
      onEvaluateFalseVariableSetters: []
      onEvaluateFalseQuestSetters: []
      onEvaluateFalse:
        m_PersistentCalls:
          m_Calls: []
  onCallCompleted:
    m_PersistentCalls:
      m_Calls: []
