%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 710e1bac7a011e4d458ef6c347ab4156, type: 3}
  m_Name: Call_LilyIntro
  m_EditorClassIdentifier:
  CallerID: {fileID: 11400000, guid: 09cdebfe05ccaad41adda79be1ca9067, type: 2}
  Stages:
  - Text: Great! Now it's time to think about expanding your customer base. You can do this by maxing out your relationship with your existing customers, but there's another option that won't take so long...
    OnStartTriggers: []
    OnDoneTriggers: []
  - Text: 'Once you''ve got a halfway decent relationship with a customer, you can approach their friends directly, and offer a <h1>free sample</h>. '
    OnStartTriggers: []
    OnDoneTriggers: []
  - Text: If your mutual relationship is good enough and they like the sample, they'll become a customer.
    OnStartTriggers: []
    OnDoneTriggers: []
  - Text: Though If your mutual relationship isn't good enough, they might not react so well, so be sure to choose who you approach carefully...
    OnStartTriggers: []
    OnDoneTriggers: []
  - Text: You can view who your existing customer's friends are in the <h1>contacts app</h>.
    OnStartTriggers: []
    OnDoneTriggers: []
  - Text: Kevin has a friend <h1>Lily</h> who might be interested in your product. She's usually seen outside <h1>town hall</h> from <h1>4pm</h> to <h1>8pm</h>.
    OnStartTriggers: []
    OnDoneTriggers: []
  - Text: Grab <h1>1x packaged OG Kush</h> and go see if she'll accept a sample.
    OnStartTriggers: []
    OnDoneTriggers: []
  onCallCompleted:
    m_PersistentCalls:
      m_Calls: []
