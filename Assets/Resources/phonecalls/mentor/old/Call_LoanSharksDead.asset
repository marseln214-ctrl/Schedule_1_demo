  m_Script: {fileID: 11500000, guid: 710e1bac7a011e4d458ef6c347ab4156, type: 3}
  m_Name: Call_LoanSharksDead
  m_EditorClassIdentifier:
  CallerID: {fileID: 11400000, guid: 09cdebfe05ccaad41adda79be1ca9067, type: 2}
  Stages:
  - Text: Well damn, I wasn't expecting that... On the bright side, looks like we don't have to worry about that debt.
    OnStartTriggers: []
    OnDoneTriggers: []
  - Text: But on the other hand, whoever took out those fellas must be some pretty serious people, and judging from that note, they ain't doin' it for charity...
    OnStartTriggers: []
    OnDoneTriggers: []
  - Text: The way I see it, they know where you live, and they got the means to do some damage, so you best go to that meeting.
    OnStartTriggers: []
    OnDoneTriggers: []
  - Text: Hopefully we can get this sorted out. I'll give you a call once you've talked to them.
    OnStartTriggers: []
    OnDoneTriggers: []
  onCallCompleted:
    m_PersistentCalls:
      m_Calls: []
